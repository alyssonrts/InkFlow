# Copie este arquivo para ".env" (na raiz do projeto) e ajuste os valores.
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).
POSTGRES_DB=inkflow
POSTGRES_USER=inkflow
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432

# Chave de assinatura dos tokens JWT (mínimo de 32 caracteres). Gere uma chave própria.
JWT_SECRET=troque_por_uma_chave_longa_com_pelo_menos_32_caracteres
# Validade do token de acesso, em minutos (opcional)
JWT_EXPIRACAO_MINUTOS=120
# Cria contas de demonstração na primeira execução; use false em qualquer uso real
INKFLOW_DEMONSTRACAO=true
